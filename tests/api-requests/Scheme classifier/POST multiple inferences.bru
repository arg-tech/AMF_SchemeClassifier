meta {
  name: POST multiple inferences
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(test-inputs/xaif_multiple_inferences.json)
}

tests {
  const validSchemes = [
    "Position to Know Argument",
    "Ad Hominem Argument",
    "Popular Acceptance",
    "Defeasible Rule-based Argument",
    "Argument Based on Cases",
    "Chained Argument with Rules and Cases",
    "Discovery Argument",
    "Practical Reasoning Argument",
    "Default Inference"
  ];

  test("Should return 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Response should be valid JSON with AIF structure", function () {
    const data = res.getBody();
    expect(data).to.have.property("AIF");
    expect(data.AIF).to.have.property("nodes");
    expect(data.AIF).to.have.property("edges");
  });

  test("Should preserve all 6 nodes", function () {
    const data = res.getBody();
    expect(data.AIF.nodes).to.have.lengthOf(6);
  });

  test("Should preserve all 4 edges", function () {
    const data = res.getBody();
    expect(data.AIF.edges).to.have.lengthOf(4);
  });

  test("Both RA nodes should be classified with valid schemes", function () {
    const data = res.getBody();
    const raNodes = data.AIF.nodes.filter(n => n.type === "RA");
    expect(raNodes).to.have.lengthOf(2);
    raNodes.forEach(node => {
      expect(validSchemes).to.include(node.text);
    });
  });

  test("All I nodes should remain unchanged", function () {
    const data = res.getBody();
    const iNodes = data.AIF.nodes.filter(n => n.type === "I");
    expect(iNodes).to.have.lengthOf(4);
  });
}
