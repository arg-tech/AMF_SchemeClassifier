meta {
  name: GET docs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/
  body: none
  auth: inherit
}

tests {
  test("Should return 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Should return HTML documentation", function () {
    const body = res.getBody();
    expect(body).to.include("Argumentation Scheme Classifier");
    expect(body).to.include("Expected Input");
    expect(body).to.include("Expected Output");
  });
}
