meta {
  name: POST complex graph
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/
  body: multipartForm
  auth: inherit
}

headers {
  Content-Type: multipart/form-data
}

body:multipart-form {
  file: @file(test-inputs/xaif_complex_graph.json)
}

tests {
  const validSchemes = [
    "Position to Know Argument",
    "Ad Hominem Argument",
    "Popular Acceptance",
    "Defeasible Rule-based Argument",
    "Argument Based on Cases",
    "Chained Argument with Rules and Cases",
    "Discovery Argument",
    "Practical Reasoning Argument",
    "Default Inference"
  ];

  test("Should return 200", function () {
    expect(res.status).to.equal(200);
  });

  test("Should preserve all 10 nodes", function () {
    const data = res.getBody();
    expect(data.AIF.nodes).to.have.lengthOf(10);
  });

  test("Should preserve all 8 edges", function () {
    const data = res.getBody();
    expect(data.AIF.edges).to.have.lengthOf(8);
  });

  test("Both RA nodes should be classified with valid schemes", function () {
    const data = res.getBody();
    const raNodes = data.AIF.nodes.filter(n => n.type === "RA");
    expect(raNodes).to.have.lengthOf(2);
    raNodes.forEach(node => {
      expect(validSchemes).to.include(node.text);
    });
  });

  test("L and YA nodes should be left untouched", function () {
    const data = res.getBody();
    const lNodes = data.AIF.nodes.filter(n => n.type === "L");
    const yaNodes = data.AIF.nodes.filter(n => n.type === "YA");
    expect(lNodes).to.have.lengthOf(2);
    expect(yaNodes).to.have.lengthOf(1);
    expect(yaNodes[0].text).to.equal("Default Transition");
  });

  test("I nodes should remain unchanged", function () {
    const data = res.getBody();
    const iNodes = data.AIF.nodes.filter(n => n.type === "I");
    expect(iNodes).to.have.lengthOf(5);
    const iTexts = iNodes.map(n => n.text);
    expect(iTexts).to.include("Dr. Smith is a leading expert on infectious diseases.");
    expect(iTexts).to.include("We should roll out the vaccine nationwide.");
  });

  test("Should preserve outer xAIF fields", function () {
    const data = res.getBody();
    expect(data).to.have.property("text");
    expect(data).to.have.property("OVA");
    expect(data.dialog).to.equal(false);
    expect(data.AIF.participants).to.have.lengthOf(1);
    expect(data.AIF.locutions).to.have.lengthOf(2);
  });
}
